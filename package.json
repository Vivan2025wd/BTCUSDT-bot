{
  "name": "privacy-trading-bot",
  "version": "1.0.0",
  "description": "Self-hosted cryptocurrency trading bot with full local control and encrypted API storage",
  "main": "src/main/main.js",
  "author": "Privacy Trading Bot Team",
  "license": "MIT",
  "homepage": "https://github.com/your-username/privacy-trading-bot#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/your-username/privacy-trading-bot.git"
  },
  "scripts": {
    "start": "electron .",
    "dev": "concurrently \"npm run dev:react\" \"npm run dev:electron\"",
    "dev:react": "webpack serve --mode development --port 3000",
    "dev:electron": "wait-on http://localhost:3000 && electron . --dev",
    "build": "webpack --mode production",
    "build:electron": "npm run build && electron-builder",
    "build:win": "npm run build && electron-builder --win",
    "build:mac": "npm run build && electron-builder --mac",
    "build:linux": "npm run build && electron-builder --linux",
    "build:all": "npm run build && electron-builder --win --mac --linux",
    "dist": "npm run build:electron",
    "pack": "electron-builder --dir",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "clean": "rimraf dist/ build/ node_modules/.cache/",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "axios": "^1.6.2",
    "buffer": "^6.0.3",
    "ccxt": "^4.1.47",
    "crypto-js": "^4.2.0",
    "electron": "^27.1.3",
    "lightweight-charts": "^4.1.3",
    "lodash": "^4.17.21",
    "lucide-react": "^0.539.0",
    "node-cron": "^3.0.3",
    "process": "^0.11.10",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "recharts": "^3.1.2",
    "sqlite3": "^5.1.6",
    "ws": "^8.14.2"
  },
  "devDependencies": {
    "@babel/core": "^7.23.5",
    "@babel/preset-env": "^7.23.5",
    "@babel/preset-react": "^7.23.3",
    "@tailwindcss/postcss": "^4.1.11",
    "@testing-library/jest-dom": "^6.1.5",
    "@testing-library/react": "^13.4.0",
    "autoprefixer": "^10.4.21",
    "babel-loader": "^9.1.3",
    "concurrently": "^8.2.2",
    "copy-webpack-plugin": "^11.0.0",
    "css-loader": "^6.8.1",
    "electron-builder": "^24.7.0",
    "eslint": "^8.55.0",
    "eslint-plugin-react": "^7.33.2",
    "global": "^4.4.0",
    "html-webpack-plugin": "^5.5.3",
    "jest": "^29.7.0",
    "postcss": "^8.5.6",
    "postcss-loader": "^8.1.1",
    "rimraf": "^5.0.5",
    "style-loader": "^3.3.3",
    "tailwindcss": "^4.1.11",
    "wait-on": "^7.2.0",
    "webpack": "^5.89.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^4.15.1"
  },
  "build": {
    "appId": "com.privacytradingbot.app",
    "productName": "Privacy Trading Bot",
    "copyright": "Copyright © 2024 Privacy Trading Bot",
    "directories": {
      "output": "dist/",
      "buildResources": "build/"
    },
    "files": [
      "src/main/",
      "src/core/",
      "src/database/",
      "src/services/",
      "build/",
      "node_modules/",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/",
        "to": "resources/",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "resources/icon.ico",
      "publisherName": "Privacy Trading Bot",
      "verifyUpdateCodeSignature": false
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "resources/icon.icns",
      "category": "public.app-category.finance",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "resources/icon.png",
      "category": "Office"
    },
    "nsis": {
      "oneClick": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Privacy Trading Bot",
      "include": "build/installer.nsh"
    },
    "dmg": {
      "title": "Privacy Trading Bot Installer",
      "icon": "resources/icon.icns",
      "background": "build/dmg-background.png",
      "contents": [
        {
          "x": 410,
          "y": 150,
          "type": "link",
          "path": "/Applications"
        },
        {
          "x": 130,
          "y": 150,
          "type": "file"
        }
      ]
    },
    "publish": {
      "provider": "github",
      "owner": "your-username",
      "repo": "privacy-trading-bot",
      "private": false
    }
  },
  "keywords": [
    "trading",
    "bot",
    "cryptocurrency",
    "bitcoin",
    "ethereum",
    "privacy",
    "local",
    "self-hosted",
    "electron",
    "binance",
    "automated-trading"
  ],
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=8.0.0"
  }
}
